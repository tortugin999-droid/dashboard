# Base de datos PostgreSQL (obligatorio). Ejemplo para desarrollo local:
# DATABASE_URL="postgresql://mi_balance:mi_balance@localhost:5433/mi_balance?schema=public"
DATABASE_URL="postgresql://mi_balance:mi_balance@localhost:5433/mi_balance?schema=public"

# Entorno: development | production
NODE_ENV="development"

# Puerto HTTP de la API
PORT="3000"

# Secreto para firmar la cookie CSRF (double-submit firmado).
# En producción genera uno con: openssl rand -base64 32
CSRF_SECRET="dev-only-change-me"

# Orígens permitidos si el frontend NO se sirve bajo el mismo sitio.
# Vacío = solo mismo origen (recomendado, con proxy /api).
ALLOWED_ORIGINS=""

# Cookie de sesión
SESSION_COOKIE_NAME="mb_session"
SESSION_TTL_DAYS="30"

# Demo user (solo se crea con `npm run seed` en desarrollo)
DEMO_USER_EMAIL="demo@mibalance.local"
DEMO_USER_PASSWORD="demo-password-2026"
